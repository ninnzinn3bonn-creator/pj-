{
  "name": "project-manager-team-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "predeploy": "node scripts/prepare-assets.mjs",
    "predeploy:check": "node scripts/prepare-assets.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "node --test test/*.test.mjs",
    "types": "wrangler types --env-interface CloudflareBindings"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/node": "^22.20.2",
    "wrangler": "^4.129.0"
  }
}
