{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "project-manager-team",
  "account_id": "0e0a429d3726245cc4d8d50e31aaf7bf",
  "workers_dev": true,
  "main": "./src/index.mjs",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "project-manager-team-data",
      "database_id": "09709fcf-2c1a-4948-8804-dea71d6618e5",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GITHUB_REPOSITORY": "ninnzinn3bonn-creator/project-manager-team-data",
    "GITHUB_BRANCH": "main",
    "TEAM_SLUG": "my-team",
    "TEAM_NAME": "開発チーム",
    "TEAM_ADMIN_GITHUB_ID": "255440642",
    "ALLOWED_LOCAL_ORIGINS": "http://127.0.0.1:4170,http://localhost:4170"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
